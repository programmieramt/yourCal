  "liveRecalculation": {
    "recommended": true,
    "rationale": "BMR/TDEE live mit echtem Gewicht berechnen macht die Zahl genauer. Das Defizit selbst sollte aber NICHT nachgezogen werden, wenn der Fortschritt hinter dem Plan liegt - sonst Spirale aus immer größerem Defizit. Lieber ein späteres/höheres Zielgewicht akzeptieren als das Defizit verschärfen.",
    "weightSmoothing": "7-Tage gleitender Durchschnitt (oder EMA) statt Rohwert des letzten Wiegetags - vermeidet Ausschläge durch Wasser/Glykogen.",
    "volumeSource": "Geplante volumeKm aus dieser JSON verwenden, oder falls verfügbar: tatsächlich geloggte km der laufenden Woche (genauer).",
    "algorithmPseudocode": [
      "rollingWeightKg = average(last 7 daily weight entries)  // fallback: average of available entries",
      "currentWeek = lookup week in weeks[] where startDate <= today <= endDate  // clamp to [1, totalWeeks]",
      "bmr = 10 * rollingWeightKg + 6.25 * heightCm - 5 * ageYears + 5",
      "tdeeBase = bmr * neatFactor  // 1.2",
      "runKcal = (rollingWeightKg * currentWeek.volumeKm * runningKcalPerKgPerKm) / 7",
      "tdee = tdeeBase + runKcal",
      "deficit = phaseDeficitKcalPerDay[currentWeek.phaseId]  // FIXED per phase, do not scale up if behind schedule",
      "targetKcalPerDay = max(floorKcalPerDay, round((tdee - deficit) / roundToNearestKcal) * roundToNearestKcal)",
      "targetKcalPerWeek = targetKcalPerDay * 7"
    ],
    "phaseDeficitKcalPerDay": { "1": 626.0, "2": 447.1, "3": 357.7, "4": 178.9, "5": 0.0, "6": 0.0 },
    "phaseDeficitNote": "Diese Werte sind mit dem Platzhalter-Gesamtverlust 10kg (85->75kg) kalibriert. Sobald das reale Startgewicht am 23.08. feststeht, total_loss = startWeightKg - targetWeightKg neu setzen und k = total_loss / 12.3 neu berechnen (12.3 = gewichtete Wochensumme aus Phasenlängen x Basis-Ratios 0.7/0.5/0.4/0.2)."
  },
  "bodyComposition": {
    "recommended": true,
    "rationale": "Fettanteil-Tracking zeigt, ob Gewichtsverlust aus Fett- oder Muskelmasse kommt - genau das Ziel ist Fett runter, Muskeln/Magermasse halten.",
    "scaleAccuracyNote": "Consumer-BIA-Waagen (bioelektrische Impedanzanalyse) sind beim ABSOLUTEN Fettanteil-Wert oft ungenau (können mehrere %-Punkte von einer DEXA-Referenzmessung abweichen). Der TREND über mehrere Wochen ist deutlich verlässlicher als der Einzelwert. Für Vergleichbarkeit: gleiche Waage, gleiche Tageszeit (idealerweise morgens nüchtern, vor dem Essen/Training), ähnlicher Hydrationszustand.",
    "weightSmoothing": "7-Tage gleitender Durchschnitt wie beim Gewicht - BIA-Werte schwanken mit Wasserhaushalt/Training/Essen tendenziell noch mehr als das reine Gewicht.",
    "derivedMetrics": { "fatMassKg": "rollingWeightKg * rollingBodyFatPercent / 100", "leanMassKg": "rollingWeightKg - fatMassKg" },
    "trackingRecommendation": "leanMassKg als eigene Trendlinie neben fatMassKg anzeigen. Bleibt leanMassKg stabil oder sinkt nur leicht, während fatMassKg klar runtergeht, läuft die Diät muskelschonend. Fällt leanMassKg spürbar/schnell: Protein-Ziel (120g/Tag) prüfen, ggf. Defizit etwas verkleinern. Krafttraining wäre der stärkste zusätzliche Hebel gegen Muskelverlust, ist aktuell nicht im Laufplan enthalten.",
    "optionalBmrUpgrade": {
      "method": "Katch-McArdle statt Mifflin-St Jeor, sobald leanMassKg aus einer aktuellen Fettanteil-Messung vorliegt - basiert auf echter Körperzusammensetzung statt Alters-/Geschlechts-Schätzung, meist etwas genauer bei trainierten Personen.",
      "formula": "bmr = 370 + 21.6 * leanMassKg",
      "fallback": "Mifflin-St Jeor (siehe calorieFormula) weiterverwenden, wenn gerade keine aktuelle Fettanteil-Messung vorliegt.",
      "noteOnPrecision": "Beide Formeln sind Schätzungen mit ca. +/-10% Unsicherheit gegenüber echter Kalorimetrie - Katch-McArdle ist nicht 'exakt', nur tendenziell etwas individueller. Für die App reicht es, sie als Alternative anzubieten statt hart umzustellen."
    },
    "noTargetCurve": "Es gibt bewusst keine wöchentliche Zielvorgabe für den Fettanteil (anders als beim Gewicht) - einfach als Beobachtungsgröße/Trend tracken, nicht als weiteres hartes Ziel.",
    "muscleMassTracking": {
      "recommended": true,
      "field": "muscleMassKg (direkt von der Waage übernehmen, falls sie das anzeigt)",
      "distinctionFromLeanMass": "muscleMassKg (Waage) ist NICHT dasselbe wie das berechnete leanMassKg (weightKg - fatMassKg). leanMassKg = alles ausser Fett (Muskeln + Knochen + Organe + Wasser). muscleMassKg ist die BIA-Schätzung speziell für Skelettmuskulatur der Waage, i.d.R. kleiner als leanMassKg. Beide Werte werden unterschiedlich sein - das ist normal, kein Fehler.",
      "sameAccuracyCaveat": "Genau wie bodyFatPercent nur als geglätteter Trend über Wochen verlässlich, nicht als Einzelwert.",
      "smoothing": "Gleicher 7-Tage-Schnitt wie bodyFatPercent/rollingWeightKg.",
      "usage": "Als zweite, unabhängige Trendlinie neben leanMassKg zeigen. Zeigen beide (leanMassKg und muscleMassKg) über mehrere Wochen stabil/leicht steigend oder nur leicht sinkend, während fatMassKg runtergeht: gutes Zeichen. Widersprechen sich beide Trends deutlich: eher Messrauschen als echtes Signal, nicht überinterpretieren."
    }
  },
  "implementationGuideForClaudeCode": {
    "context": "Dies ist eine Datenquelle für ein Feature-Update einer bestehenden Android-Kalorien-Tracking-App (Eigenbau des Nutzers). Kein vollständiger App-Spec - die Datei liefert Trainingsplan-Daten, Formeln und Tracking-Logik, die in die bestehende App integriert werden sollen.",
    "suggestedFeatures": [
      "Trainingsplan-Ansicht: Wochen aus weeks[] anzeigen (Datum, Phase, Sessions inkl. Ruhetage, Meilensteine), idealerweise mit Abhak-Funktion pro Session",
      "Kalorienziel live berechnen statt die fest hinterlegten weeks[].targetKcalPerDay-Werte 1:1 zu übernehmen - siehe liveRecalculation-Block für Formel/Pseudocode. Die Werte in weeks[] sind nur Platzhalter/Fallback (mit vorläufigem Startgewicht 85kg gerechnet, siehe meta.weightStatus), keine finalen Werte.",
      "Körperzusammensetzung: bodyFatPercent + optional muscleMassKg als tägliche/wöchentliche Eingabe, geglättet (7-Tage-Schnitt) getrackt, siehe bodyComposition-Block für Formeln (fatMassKg, leanMassKg) und Interpretationshinweise",
      "Gewichts-Eingabe weiterhin täglich möglich, aber BMR-Berechnung auf rollingWeightKg (7-Tage-Schnitt) statt Rohwert stützen"
    ],
    "doNotHardcode": "targetKcalPerDay/targetKcalPerWeek aus weeks[] NICHT als feste Werte in die App übernehmen - das sind nur Beispiel-/Startwerte. Die App soll sie live aus liveRecalculation neu berechnen, sobald echtes Gewicht (und optional Körperfett) eingegeben wird.",
    "afterWeightUpdate": "Sobald der Nutzer sein reales Startgewicht (erwartet 23.08.2026) kennt, sollte total_loss = startWeightKg - targetWeightKg neu gesetzt und k = total_loss / 12.3 neu berechnet werden (siehe liveRecalculation.phaseDeficitNote) - entweder einmalig hier in der JSON oder direkt in der App-Logik."
  }
